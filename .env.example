# ---------------------------------------------------------------------------
# Facebook AI Photo Automation - environment template
# Copy to .env (never commit it) or set these in your host's environment.
# No paid API is used by default. Everything below is optional except the
# Facebook Page credentials, which are only required when you actually publish.
# ---------------------------------------------------------------------------

# --- Facebook Page publishing (official Meta Graph API) ---------------------
# Leave empty to keep publishing disabled. The dashboard will show "not configured".
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
GRAPH_API_VERSION=v23.0

# --- Image generation (free / open source providers) ------------------------
# pollinations : free, no account or API key required (default)
# huggingface  : free-tier Hugging Face Inference API token (FLUX.1-schnell)
# local        : your own self-hosted Stable Diffusion (AUTOMATIC1111/Forge API)
# placeholder  : fully offline procedural artwork, for pipeline testing only
IMAGE_PROVIDER=pollinations
FALLBACK_PROVIDER=placeholder

# Optional: Pollinations token (still free, raises rate limits)
POLLINATIONS_TOKEN=
POLLINATIONS_MODEL=flux

# Optional: Hugging Face free-tier token -> https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=black-forest-labs/FLUX.1-schnell

# Optional: self-hosted Stable Diffusion web UI API (free, runs on your machine)
LOCAL_SD_URL=http://127.0.0.1:7860
LOCAL_SD_STEPS=28
LOCAL_SD_CFG_SCALE=6.5

# --- Publishing safety ------------------------------------------------------
# Manual approval mode: every generated photo must be approved in the dashboard
# (or CLI) before it can be published.
REQUIRE_APPROVAL=true
# Auto-publish only approved posts from the scheduler. Keep false until you
# have reviewed the pipeline and configured the Page credentials.
AUTO_PUBLISH=false
# Maximum photos the scheduler generates per run.
POSTS_PER_RUN=3
# Minutes between scheduler runs.
SCHEDULER_INTERVAL_MINUTES=180

# --- Duplicate detection ----------------------------------------------------
# Hamming distance threshold for perceptual hashes (0 = identical, higher = looser)
PHASH_THRESHOLD=6

# --- Image output -----------------------------------------------------------
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1080
JPEG_QUALITY=92

# --- Local storage ----------------------------------------------------------
DATABASE_PATH=data/app.db
MEDIA_DIR=data/media

# --- Dashboard access -------------------------------------------------------
# Leave empty for open local access. Set a password to require login.
DASHBOARD_PASSWORD=

# --- Optional: local LLM captions through Ollama (free, offline) ------------
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# --- Flask ----------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
